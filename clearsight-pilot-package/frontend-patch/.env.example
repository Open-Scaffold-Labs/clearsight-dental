# ClearSight Dental — Vercel Frontend Environment
# Set these as Environment Variables in the Vercel project settings.

# ------ Public ------
NEXT_PUBLIC_APP_ORIGIN=https://clearsight-dental-pilot.vercel.app

# ------ Database (Neon, same instance as backend) ------
# Use the POOLED connection URL for the edge runtime.
DATABASE_URL=postgresql://USER:PASSWORD@ep-POOLER.neon.tech/clearsight?sslmode=require

# ------ Session JWT signing ------
# 64-byte hex. Generate with: openssl rand -hex 32
SESSION_SECRET=REPLACE_ME

# ------ Shared secret to the Fly.io backend ------
# Must match SHARED_API_SECRET set via `fly secrets set` on the backend app.
SHARED_API_SECRET=REPLACE_ME
BACKEND_URL=https://clearsight-backend-pilot.fly.dev

# ------ Email (Resend) ------
RESEND_API_KEY=re_REPLACE_ME
RESEND_FROM="ClearSight Dental <noreply@clearsight-dental.com>"

# ------ Document versions (must match files published under /public/legal/) ------
BAA_VERSION=v1.0
CPA_VERSION=v1.0
