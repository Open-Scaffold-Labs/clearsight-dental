# ClearSight Dental — Pilot Backend Environment
# Copy to .env for local dev; set as Fly.io secrets for production.

# Neon pooled connection string (the pooler endpoint, not the direct host)
DATABASE_URL=postgresql://USER:PASSWORD@ep-POOLER.neon.tech/clearsight?sslmode=require

# 64-byte hex secret shared with the Vercel frontend edge.
# Generate with: openssl rand -hex 32
SHARED_API_SECRET=REPLACE_ME

# CORS origin (Vercel preview URL during pilot; custom domain later)
FRONTEND_ORIGIN=https://clearsight-dental-pilot.vercel.app

# Pilot tenant slug — matches tenants.id in Postgres
PILOT_TENANT_ID=dia-basher-dds

# Retention for audit_log (HIPAA minimum = 6 years = 2190 days)
AUDIT_LOG_RETENTION_DAYS=2190

# Model paths inside the container (baked in by the Dockerfile)
MODEL_DIR=/app/models/oralgpt-omni-7b
MODEL_NAME=oralgpt-omni-7b

# Inference concurrency cap (A100-40GB safely runs one 7B VLM at a time)
MAX_CONCURRENT=1

LOG_LEVEL=info
